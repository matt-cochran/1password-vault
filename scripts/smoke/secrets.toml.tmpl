# Rendered by run.sh; each placeholder is filled from its OPV_SMOKE_* variable.
# IDs and names only, never values.

[profile]
kind = "fleet"

# Azure Key Vault + Container Apps
[environments.azure]
vault_id = "@@OPV_SMOKE_OP_VAULT_ID@@"
item_id  = "@@OPV_SMOKE_OP_ITEM_ID@@"
account  = "@@OPV_SMOKE_OP_ACCOUNT@@"

[environments.azure.azure]
subscription   = "@@OPV_SMOKE_AZ_SUBSCRIPTION@@"
key_vault      = "@@OPV_SMOKE_AZ_KEY_VAULT@@"
resource_group = "@@OPV_SMOKE_AZ_RG@@"
container_app  = "@@OPV_SMOKE_AZ_APP@@"
identity       = "system"
env_name       = "FLEET__{PRODUCT}__{KEY}"

# Kubernetes Secrets + Deployment (kind)
[environments.kubernetes]
vault_id = "@@OPV_SMOKE_OP_VAULT_ID@@"
item_id  = "@@OPV_SMOKE_OP_ITEM_ID@@"
account  = "@@OPV_SMOKE_OP_ACCOUNT@@"

[environments.kubernetes.kubernetes]
context    = "@@OPV_SMOKE_K8S_CONTEXT@@"
namespace  = "@@OPV_SMOKE_K8S_NAMESPACE@@"
deployment = "@@OPV_SMOKE_K8S_DEPLOYMENT@@"
env_name   = "FLEET__{PRODUCT}__{KEY}"

# Key Vault -> Kubernetes through the External Secrets Operator.
# A different env_name keeps its managed set apart from the environment above
# (same context, namespace and Deployment with the same template is a config error).
[environments.eso]
vault_id = "@@OPV_SMOKE_OP_VAULT_ID@@"
item_id  = "@@OPV_SMOKE_OP_ITEM_ID@@"
account  = "@@OPV_SMOKE_OP_ACCOUNT@@"

[environments.eso.kubernetes]
context    = "@@OPV_SMOKE_K8S_CONTEXT@@"
namespace  = "@@OPV_SMOKE_K8S_NAMESPACE@@"
deployment = "@@OPV_SMOKE_K8S_DEPLOYMENT@@"
env_name   = "ESO__{PRODUCT}__{KEY}"
secrets_in = "prod-vault"

# GitHub Actions: repository secrets and variables. Rendered only when github is targeted.
# BEGIN TARGET github
[environments.github]
vault_id = "@@OPV_SMOKE_OP_VAULT_ID@@"
item_id  = "@@OPV_SMOKE_OP_ITEM_ID@@"
account  = "@@OPV_SMOKE_OP_ACCOUNT@@"

[environments.github.github]
repo        = "@@OPV_SMOKE_GH_REPO@@"
secret_name = "SMOKE_{KEY}"
# END TARGET

# GitHub Actions: one GitHub environment's secrets and variables. Rendered only when
# githubenv is targeted; the environment must already exist (opv never creates one).
# BEGIN TARGET githubenv
[environments.githubenv]
vault_id = "@@OPV_SMOKE_OP_VAULT_ID@@"
item_id  = "@@OPV_SMOKE_OP_ITEM_ID@@"
account  = "@@OPV_SMOKE_OP_ACCOUNT@@"

[environments.githubenv.github]
repo        = "@@OPV_SMOKE_GH_REPO@@"
environment = "@@OPV_SMOKE_GH_ENVIRONMENT@@"
secret_name = "SMOKE_{KEY}"
# END TARGET

[stores.prod-vault]
azure_key_vault = "@@OPV_SMOKE_AZ_KEY_VAULT@@"
subscription    = "@@OPV_SMOKE_AZ_SUBSCRIPTION@@"
secret_store    = "@@OPV_SMOKE_ESO_STORE@@"

[products.smoke.keys.DB_URL]
kind = "secret"
environments = ["azure", "kubernetes", "eso", "github", "githubenv"]

[products.smoke.keys.API_TOKEN]
kind = "secret"
environments = ["azure", "kubernetes", "eso", "github", "githubenv"]

# KEEP: the first config. PRUNE: the config for the prune step, where LOG_LEVEL stays
# declared but is wanted nowhere; --prune removes only declared keys (FR-8, SR-6).
[products.smoke.keys.LOG_LEVEL]
kind = "config"
# BEGIN KEEP
environments = ["azure", "kubernetes", "eso", "github", "githubenv"]
# END KEEP
# BEGIN PRUNE
environments = []
# END PRUNE
