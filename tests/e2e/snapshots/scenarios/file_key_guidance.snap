# file_key_guidance: the file-key guidance through the real binary

## opv next dev text exit: 0
## opv next dev text stdout
next: opv set web/API_KEY --env dev
then:
  opv set web/TLS_CERTIFICATE --env dev --from-file <PATH>
findings:
  single_writer: vault vE2EWEBDEV0000000000000001 (environment dev) has only one writer; a deployed tier needs a second writer to fix a value when the first is unavailable

## opv next dev text stderr
using <SCENARIO>/project/secrets.toml

## opv next dev --json exit: 0
## opv next dev --json stdout
{"schema_version":3,"ok":true,"queue":[{"kind":"enter_value","actor":"person","command":"opv set web/TLS_CERTIFICATE --env dev --from-file <PATH>","product":"web","key":"TLS_CERTIFICATE","env":"dev","vault":"vE2EWEBDEV0000000000000001"}],"waits_on":[],"findings":[{"code":"single_writer","env":"dev","vault":"vE2EWEBDEV0000000000000001","message":"vault vE2EWEBDEV0000000000000001 (environment dev) has only one writer; a deployed tier needs a second writer to fix a value when the first is unavailable"}],"next":{"kind":"enter_value","actor":"person","command":"opv set web/API_KEY --env dev"},"do":null}

## opv next dev --json stderr
using <SCENARIO>/project/secrets.toml

## opv inventory dev text exit: 0
## opv inventory dev text stdout
key                   dev[shared]
shared/DATABASE_URL   unreadable(no_access)/-
shared/FEATURE_FLAGS  unreadable(no_access)/-
web/API_KEY           absent/W
web/DATABASE_URL      unreadable(no_access)/-
web/LOG_LEVEL         set/W
web/MIGRATION_TOKEN   set/W
web/OTEL_RESOURCE@    -
web/PERSONAL_LLM_KEY  unreadable(no_access)/-
web/SESSION_SECRET    set/W
web/TLS_CERTIFICATE@  absent/W
web/TLS_PRIVATE_KEY@  set/W
dev[shared]: shared=vE2ESHAREDDEV00000000000001/iE2ESHAREDDEV00000000000001 web=vE2EWEBDEV0000000000000001/iE2EWEBDEV0000000000000001
next: opv set web/API_KEY --env dev

